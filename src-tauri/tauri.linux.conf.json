{
  "$schema": "https://schema.tauri.app/config/2.0.json",
  "app": {
    "windows": [
      {
        "title": "ChaiLauncher",
        "width": 1600,
        "height": 900,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 480,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
